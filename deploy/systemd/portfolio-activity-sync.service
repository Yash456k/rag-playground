[Unit]
Description=Refresh the server-side portfolio activity cache
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=1h
StartLimitBurst=3

[Service]
Type=oneshot
WorkingDirectory=%h/portfolio-activity-sync
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=ACTIVITY_CODEX_AUTH_SOURCE=hermes
Environment=PYTHONPATH=%h/.hermes/hermes-agent
Environment=CI=1
Environment=NO_COLOR=1
Environment=ACTIVITY_CACHE_PATH=%h/.local/share/rag-playground/activity.json
UMask=0077
ExecStart=%h/.hermes/hermes-agent/venv/bin/python %h/portfolio-activity-sync/scripts/sync_portfolio_activity.py
TimeoutStartSec=15min
Restart=on-failure
RestartSec=5min
NoNewPrivileges=true
PrivateTmp=true
